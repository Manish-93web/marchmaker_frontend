    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@marchmaker/shared": "workspace:^",
    "@marchmaker/ui": "workspace:^",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-query": "^5.104.3",
    "framer-motion": "^14.2.0",
    "i18next": "^26.4.5",
    "lucide-react": "^1.57.0",
    "qrcode": "^1.5.4",
    "react": "18",
    "react-dom": "18",
    "react-easy-crop": "^6.2.4",
